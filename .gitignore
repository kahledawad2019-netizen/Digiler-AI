# ============================================================================
# Digiler AI — .gitignore (production / public release)
# Excludes secrets, virtual envs, dependencies, runtime data, and the raw
# (copyrighted) Knowledge Base. Keeps source, config, schemas, tests, docs.
# ============================================================================

# --- Secrets & credentials (NEVER commit) -----------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.local
*client_secret*.json
*credentials*.json
*.pem
*.key
*token*.json
*.p12

# --- Python -----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js ---------------------------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Runtime data stores (regenerated by ingestion — do NOT publish) --------
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Raw / copyrighted Knowledge Base (excluded for copyright & privacy) -----
# The original Digilians academic corpus is intentionally NOT published.
# See knowledge_base/README.md for the expected structure and how to ingest.
KNOWLEDGE BASE/
Basic_knowladg/
knowledge_base/raw/
knowledge_base/derived/
knowledge_base/_incoming/
knowledge_base/_quarantine/

# Benchmark samples may contain raw corpus text — exclude
reports/**/sample_*.json
reports/**/*_sample.json

# --- Local tooling / downloads ----------------------------------------------
.tools/
*.zip

# --- Logs / temp ------------------------------------------------------------
logs/
tmp/
temp/
*.log

# --- Large / binary decks & media -------------------------------------------
*.pptx
*.mp4
*.mov

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
