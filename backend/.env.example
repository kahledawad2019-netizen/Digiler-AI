# Digiler AI backend configuration (copy to backend/.env). All optional — sensible
# dev defaults are used when unset.

# --- API ---
DIGILER_ENV=development                 # development | production
DIGILER_CORS_ORIGINS=http://localhost:3000
DIGILER_SECRET_KEY=change-me-in-production-with-a-long-random-value
DIGILER_ACCESS_TOKEN_MINUTES=30
DIGILER_REFRESH_TOKEN_DAYS=14

# --- Database (SQLite by default; switch to Postgres for production) ---
# dev:  sqlite+aiosqlite:///./digiler.db
# prod: postgresql+asyncpg://digiler:digiler@postgres:5432/digiler
DIGILER_DATABASE_URL=sqlite+aiosqlite:///./digiler.db

# --- Redis (optional; caching / rate-limit / sessions) ---
DIGILER_REDIS_URL=redis://localhost:6379/0

# --- The existing ala platform config (reused as-is) ---
ALA_CONFIG=../config/platform.yaml

# --- LLM (Ollama) — read by the ala platform; documented here for convenience ---
ALA_LLM_PROVIDER=ollama
ALA_LLM_MODEL=qwen3
ALA_LLM_BASE_URL=http://localhost:11434
HF_HUB_OFFLINE=1

# --- Web Search (Research Mode) — overrides config/platform.yaml, zero code change ---
# provider: wikipedia (no key, reliable, bilingual) | duckduckgo | tavily | google | disabled
ALA_RESEARCH_PROVIDER=wikipedia
# ALA_RESEARCH_API_KEY=          # required for tavily / google
# ALA_RESEARCH_GOOGLE_CX=        # required for google Custom Search
ALA_RESEARCH_MAX_RESULTS=6
